{
  "name": "la-pata-gorda-frontapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --force",
    "format": "prettier --write \"src/**/*.{ts,vue,scss,json,md}\"",
    "cf:dev": "npm run build && wrangler dev --port 8788",
    "cf:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "axios": "^1.13.2",
    "pinia": "^3.0.2",
    "vue": "^3.5.13",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/tsconfig": "^0.8.1",
    "prettier": "^3.6.2",
    "sass": "^1.95.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vue-tsc": "^3.1.0",
    "wrangler": "^4.154.0"
  }
}
